              "pm.test('El nombre fue actualizado', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.nombre).to.eql('Charmeleon');",
              "});",
              "",
              "pm.test('Los campos no enviados se mantienen igual (tipo sigue Fuego)', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.tipo).to.eql('Fuego');",
              "});"
            ],
