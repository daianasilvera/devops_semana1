  "item": [
    {
      "name": "1. GET - Listar todos los Pokémon",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('La respuesta es un array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test('Content-Type es JSON', function () {",
              "    pm.response.to.have.header('Content-Type');",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "pm.test('Tiempo de respuesta menor a 1000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pokemons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pokemons"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. POST - Crear un nuevo Pokémon",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('El Pokémon creado tiene un id', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.collectionVariables.set('pokemonId', jsonData.id);",
              "});",
              "",
              "pm.test('El nombre coincide con lo enviado', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.nombre).to.eql('Charmander');",
              "});",
              "",
              "pm.test('El tipo coincide con lo enviado', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.tipo).to.eql('Fuego');",
              "});",
              "",
              "pm.test('Las características fueron guardadas correctamente', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.caracteristicas.peso).to.eql(8.5);",
              "    pm.expect(jsonData.caracteristicas.fuerza).to.eql(40);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Charmander\",\n  \"imagen\": \"https://link.jpg\",\n  \"caracteristicas\": {\n    \"peso\": 8.5,\n    \"altura\": 0.6,\n    \"fuerza\": 40,\n    \"edad\": 2\n  },\n  \"habilidades\": [\"Ascuas\"],\n  \"tipo\": \"Fuego\",\n  \"habitat\": \"Montañas\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pokemons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pokemons"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. GET - Obtener Pokémon por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('El id devuelto coincide con el solicitado', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(String(jsonData.id)).to.eql(pm.collectionVariables.get('pokemonId'));",
              "});",
              "",
              "pm.test('El objeto tiene todos los campos esperados', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.all.keys('id', 'nombre', 'imagen', 'caracteristicas', 'habilidades', 'tipo', 'habitat');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pokemons/{{pokemonId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pokemons",
            "{{pokemonId}}"
          ]
        }
      },
      "response": []
    },
